        "scientific_name": "Sambucus nigra",
        "common_names": ["Elderberry", "Black Elder"],
        "identification_features": ["compound leaves with 5-7 leaflets", "clusters of small white flowers", "dark purple berries", "woody stems with pith"],
        "safety_note": "Berries and flowers are edible when cooked. Raw berries and leaves contain cyanogenic glycosides."
      },
      "dangerous_plant": {
        "name": "Water Hemlock",
        "scientific_name": "Cicuta virosa",
        "common_names": ["Water Hemlock", "Cowbane"],
        "identification_features": ["compound leaves", "white umbel flowers", "grows in wet areas", "purple-spotted or mottled stem"],
        "toxicity": "fatal - seizures and respiratory failure"
      },
      "confusion_risk": "moderate",
      "confusion_context": ["wetland areas", "similar leaf structure", "both have white flowers"],
      "traditional_use_warning": "Elderberry has documented safe uses when properly prepared. Water hemlock is one of the most toxic plants. Do not forage without expert identification.",
      "source": "North American Native Plant Society",
      "source_type": "authoritative",
      "evidence_quality": "high",
      "notes": "Different habitat preferences (elderberry likes disturbed areas, water hemlock likes wetlands) but confusion is possible."
