    {
      "id": "wild_carrot_vs_poison_hemlock",
      "category": "dangerous_look_alike",
      "safety_status": "high_risk_confusion",
      "risk_level": "critical",
      "safe_plant": {
        "name": "Wild Carrot",
        "scientific_name": "Daucus carota",
        "common_names": ["Queen Anne's Lace", "Wild Carrot"],
        "identification_features": ["hairy stem", "purple flower center", "carrot-like smell when crushed", "biennial"]
      },
      "dangerous_plant": {
        "name": "Poison Hemlock",
        "scientific_name": "Conium maculatum",
        "common_names": ["Poison Hemlock", "Deadly Hemlock"],
        "identification_features": ["smooth stem with purple spots", "no purple flower center", "unpleasant musty smell", "hollow stem"],
        "toxicity": "fatal - respiratory paralysis"
      },
      "confusion_risk": "high",
      "confusion_context": ["wild foraging", "beginner herbalists", "similar umbel flower structure"],
      "traditional_use_warning": "Wild carrot has some traditional uses but identification errors are common and fatal. Extreme caution required.",
      "source": "United States Department of Agriculture (USDA) - Plant Guide",
      "source_type": "authoritative",
      "evidence_quality": "high",
      "notes": "This is one of the most dangerous plant confusions. Poison hemlock is frequently mistaken for wild carrot."
    },
